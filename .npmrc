# Use the public npm registry for this project.
#
# The machine-level default may point at an internal mirror that is not always
# reachable (and fails by hanging rather than erroring). Pinning it here keeps
# `npm ci` working the same way locally and in CI.
#
# Never put an auth token in this file: it is committed. .dockerignore also
# excludes it from the image build context so it can never end up in a layer.
registry=https://registry.npmjs.org/

# Refuse to install on Node < 24 (see "engines" in package.json) with a clear
# message, instead of failing later with a confusing type-stripping error.
engine-strict=true
